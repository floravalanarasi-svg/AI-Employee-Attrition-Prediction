import random
import math
from collections import defaultdict

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# -----------------------------
# Basic Plot Settings
# -----------------------------
plt.rcParams["figure.figsize"] = (8, 5)
plt.rcParams["figure.autolayout"] = True

# -----------------------------
# Simulation Configuration
# -----------------------------
NUM_STUDENTS = 50000            # Total students
NUM_SERVERS = 5                 # Backend servers
SIMULATION_WINDOW = 3600        # Seconds (1 hour)
BASE_PROCESSING_RATE = 15       # Requests per second per server

RANDOM_SEED = 42
random.seed(RANDOM_SEED)
np.random.seed(RANDOM_SEED)

# -----------------------------
# Generate Fake Result Dataset
# -----------------------------
departments = ["CSE", "ECE", "EEE", "MECH", "CIVIL", "IT"]
semesters = list(range(1, 9))

def generate_roll_no(i):
    """
    Simple roll pattern:
    ANNA2025 + DEPT + 5-digit serial
    Example: ANNA2025CSE00001
    """
    dept = random.choice(departments)
    return f"ANNA2025{dept}{i:05d}"

def random_name():
    first = random.choice(["Arun", "Manoj", "Deepak", "Sita", "Priya", "Kavya", "Rahul", "Anita"])
    last = random.choice(["Kumar", "Devi", "Rao", "Nair", "Singh", "Sharma"])
    return f"{first} {last}"

rows = []
for i in range(1, NUM_STUDENTS + 1):
    roll_no = generate_roll_no(i)
    name = random_name()
    dept = roll_no[8:11]               # Extract dept from roll number
    sem = random.choice(semesters)
    gpa = max(0, min(10, round(np.random.normal(7.0, 1.2), 2)))
    total_marks = int(gpa * 10 * 6)    # Simple mapping
    result_status = "PASS" if gpa >= 5 else random.choice(["FAIL", "ARREAR"])

    rows.append([roll_no, name, dept, sem, result_status, gpa, total_marks])

results_df = pd.DataFrame(
    rows,
    columns=["roll_no", "name", "department", "semester",
             "result_status", "gpa", "total_marks"]
)

print("Sample of Result Dataset:")
print(results_df.head())

# Save CSV (optional)
results_df.to_csv("anna_university_results_50000.csv", index=False)
print("\nCSV File 'anna_university_results_50000.csv' generated successfully!")

# -----------------------------
# Request Arrival Time Model
# -----------------------------
def generate_request_times(num_students, window_seconds):
    """
    Generate arrival times of student requests.
    Using exponential distribution so most students
    come early, near result release.
    """
    scale = window_seconds / 10
    t = np.random.exponential(scale=scale, size=num_students)
    t = np.clip(t, 0, window_seconds)
    t.sort()
    return t

arrival_times = generate_request_times(NUM_STUDENTS, SIMULATION_WINDOW)

requests_df = pd.DataFrame({
    "student_index": np.arange(NUM_STUDENTS),
    "arrival_time": arrival_times
})

print("\nSample of Request Arrival Dataset:")
print(requests_df.head())

# -----------------------------
# Server Class
# -----------------------------
class Server:
    def __init__(self, server_id, base_rate):
        self.server_id = server_id
        # Small random variation in processing rate
        self.processing_rate = max(1, np.random.normal(base_rate, base_rate * 0.1))
        self.next_free_time = 0.0
        self.total_busy_time = 0.0
        self.num_requests = 0

    def handle_request(self, arrival_time):
        """
        Simulate handling of a single request.
        Returns: (response_time, start_time, finish_time)
        """
        # If server is free, start at arrival_time, else wait
        start_time = max(arrival_time, self.next_free_time)

        # Service time ~ exponential(mean = 1 / processing_rate)
        service_time = np.random.exponential(1.0 / self.processing_rate)

        finish_time = start_time + service_time

        # Update stats
        self.next_free_time = finish_time
        self.total_busy_time += service_time
        self.num_requests += 1

        response_time = finish_time - arrival_time
        return response_time, start_time, finish_time

# -----------------------------
# Load Balancer Strategies
# -----------------------------
def choose_server_round_robin(servers, state):
    idx = state.get("rr_index", 0)
    server = servers[idx]
    state["rr_index"] = (idx + 1) % len(servers)
    return server

def choose_server_least_connections(servers, state):
    # Approximate least-connections by who will be free the earliest
    return min(servers, key=lambda s: s.next_free_time)

def choose_server_random(servers, state):
    return random.choice(servers)

def choose_server_single(servers, state):
    # No load balancing: only server 0 used
    return servers[0]

STRATEGIES = {
    "single_server": choose_server_single,
    "round_robin": choose_server_round_robin,
    "least_connections": choose_server_least_connections,
    "random_choice": choose_server_random,
}

# -----------------------------
# Simulation Engine
# -----------------------------
def simulate_load_balancing(requests_df, strategy_name):
    """
    Simulate load balancing for given strategy.
    Returns:
        metrics dict with:
          - strategy
          - avg (average response time)
          - max (max response time)
          - server_stats (per-server statistics)
          - details (per-request details)
    """
    servers = [Server(i, BASE_PROCESSING_RATE) for i in range(NUM_SERVERS)]
    strategy_fn = STRATEGIES[strategy_name]
    state = {}

    response_times = []
    server_ids = []
    start_times = []
    finish_times = []

    for _, row in requests_df.iterrows():
        arrival = row["arrival_time"]
        server = strategy_fn(servers, state)

        rt, st, ft = server.handle_request(arrival)

        response_times.append(rt)
        server_ids.append(server.server_id)
        start_times.append(st)
        finish_times.append(ft)

    # Build per-request details
    result = requests_df.copy()
    result["server_id"] = server_ids
    result["response_time"] = response_times
    result["start_time"] = start_times
    result["finish_time"] = finish_times

    # Per-server stats
    server_stats = pd.DataFrame([
        {
            "server_id": s.server_id,
            "num_requests": s.num_requests,
            "utilization": s.total_busy_time / SIMULATION_WINDOW
        }
        for s in servers
    ])

    metrics = {
        "strategy": strategy_name,
        "avg": float(np.mean(response_times)),
        "max": float(np.max(response_times)),
        "server_stats": server_stats,
        "details": result
    }
    return metrics

# -----------------------------
# Run All Strategies
# -----------------------------
strategies = ["single_server", "round_robin", "least_connections", "random_choice"]
results = {}

summary_rows = []
print("\nRunning simulations for all strategies...\n")

for s in strategies:
    print(f"Simulating strategy: {s}")
    r = simulate_load_balancing(requests_df, s)
    results[s] = r
    summary_rows.append([s, r["avg"], r["max"]])

summary_df = pd.DataFrame(summary_rows, columns=["Strategy", "Avg Response Time", "Max Response Time"])

print("\n=== Summary of Strategies ===")
print(summary_df)

# -----------------------------
# Plot 1: Average Response Time
# -----------------------------
plt.figure()
plt.bar(summary_df["Strategy"], summary_df["Avg Response Time"])
plt.title("Average Response Time Comparison")
plt.xlabel("Strategy")
plt.ylabel("Average Response Time (seconds)")
plt.xticks(rotation=15)
plt.show()

# -----------------------------
# Plot 2: Maximum Response Time
# -----------------------------
plt.figure()
plt.bar(summary_df["Strategy"], summary_df["Max Response Time"])
plt.title("Maximum Response Time Comparison")
plt.xlabel("Strategy")
plt.ylabel("Maximum Response Time (seconds)")
plt.xticks(rotation=15)
plt.show()

# -----------------------------
# Plot 3: Per-Server Load Distribution
# -----------------------------
for strat in strategies:
    stats = results[strat]["server_stats"]
    plt.figure()
    plt.bar(stats["server_id"].astype(str), stats["num_requests"])
    plt.title(f"Per-Server Load Distribution - {strat}")
    plt.xlabel("Server ID")
    plt.ylabel("Number of Requests Handled")
    plt.show()

# -----------------------------
# Final Text Summary
# -----------------------------
print("\n=== Final Load Balancing Comparison ===")
for _, row in summary_df.iterrows():
    print(
        f"{row['Strategy']:>15} | "
        f"Avg: {row['Avg Response Time']:.4f} s | "
        f"Max: {row['Max Response Time']:.4f} s"
    )

print("\nProject simulation completed successfully.")
print("You can now use the graphs and summary table in your report / PPT.")
